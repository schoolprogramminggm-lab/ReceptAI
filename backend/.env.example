# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env  (Windows)

# Ключ Gemini API — получить на aistudio.google.com (бесплатно)
GEMINI_API_KEY=

# Название модели Gemini с поддержкой изображений
GEMINI_MODEL=gemini-2.0-flash

# Порог нечёткого совпадения по справочнику (0-100, рекомендуем 85)
MATCH_THRESHOLD=85
