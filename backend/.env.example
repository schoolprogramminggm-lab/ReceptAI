# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env  (Windows)

# Ключ Gemini API — получить на aistudio.google.com (бесплатно)
GEMINI_API_KEY=

# Название модели Gemini с поддержкой изображений
GEMINI_MODEL=gemini-3.8-flash

# Запасная модель: если основная отвечает 503/429 (перегрузка) 3 раза подряд, сервер один раз
# пробует её. Впишите название другой модели Gemini с поддержкой изображений.
# Пусто — запасной модели нет.
GEMINI_FALLBACK_MODEL=

# Порог нечёткого совпадения по справочнику лекарств (0-100, рекомендуем 85).
# Похожесть >= порога — лекарство найдено, меньше — «Не уверен, возможно это …»
DRUG_MATCH_THRESHOLD=85

